# Required for per-user Jira credential encryption. Generate, do not reuse this placeholder:
# openssl rand -base64 32 | tr '+/' '-_'
JIRA_CREDENTIAL_KEYS=replace-with-url-safe-base64-32-byte-key

JIRA_BASE_URL=https://jira.example.com
# Optional, only when Activity Stream links legitimately target this origin.
CONFLUENCE_BASE_URL=https://confluence.example.com

# Optional shared Jira event-stream service account.
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=

# Optional runtime settings.
ACTIVITY_DIR=data/jira-activity
APP_ENV=development
COOKIE_SECURE=false
