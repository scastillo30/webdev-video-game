{
  "name": "webdev-mmorpg",
  "private": true,
  "scripts": {
    "frontend:install": "npm --prefix frontend install",
    "frontend:start": "npm --prefix frontend start",
    "frontend:build": "npm --prefix frontend run build",
    "backend:start": "cd backend && go run ./cmd/server",
    "dev": "npm-run-all --parallel backend:start frontend:start"
  },
  "devDependencies": { "npm-run-all": "^4.1.5" }
}
