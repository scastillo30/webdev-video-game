{
  "name": "webdev-mmorpg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "frontend:install": "npm --prefix frontend install",
    "frontend:start": "npm --prefix frontend start",
    "frontend:build": "npm --prefix frontend run build",
    "backend:start": "cd backend && go run ./cmd/server",
    "dev": "npm-run-all --parallel backend:start frontend:start",
    "local:frontend:start": "cd frontend && ../.tools/node/bin/node node_modules/@angular/cli/bin/ng.js serve --proxy-config proxy.conf.json",
    "local:frontend:build": "cd frontend && ../.tools/node/bin/node node_modules/@angular/cli/bin/ng.js build",
    "local:backend:start": "cd backend && ../.tools/go/bin/go run ./cmd/server",
    "local:backend:build": "cd backend && ../.tools/go/bin/go build -o bin/webdev-server ./cmd/server",
    "verify:characters": "node scripts/verify-character-assets.mjs",
    "test:backend": "cd backend && go test ./...",
    "test:engine": "npm --prefix frontend run test:engine",
    "release:build": "node scripts/build-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:candidate": "node scripts/verify-release-candidate.mjs",
    "soak:verify": "node scripts/verify-soak-report.mjs",
    "test:release-tools": "node --test scripts/release-tools.test.mjs",
    "quality:check": "node scripts/quality-gate.mjs",
    "db:backup": "cd backend && go run ./cmd/admin backup",
    "db:verify": "cd backend && go run ./cmd/admin verify",
    "db:restore": "cd backend && go run ./cmd/admin restore",
    "db:prune": "cd backend && go run ./cmd/admin prune"
  },
  "devDependencies": { "npm-run-all": "^4.1.5" }
}
